diff --git a/build.py b/build.py
index c5f16e8..f5adbb1 100644
--- a/build.py
+++ b/build.py
@@ -21,6 +21,47 @@ def fail(msg):
     sys.exit(1)
 
 
+# The hat layer is where a player's skin glasses live. The 2nd-layer eyebrow
+# variants must sit *behind* the hat plane, or they draw over the lens and the
+# two surfaces fight for the same depth as the camera turns. This was true of
+# right_brow5..8 and left_brow5..8, which sat at -4.550, 0.05 in front of the
+# hat at -4.500.
+HAT_PLANE = -4.5
+
+
+def check_head_layers(path):
+    """Fail if any eyebrow box sits at or in front of the hat layer plane."""
+    import glob
+    data = json.loads(path.read_text(encoding="utf-8"))
+    for model in data.get("models", []):
+        if model.get("id") not in ("head", "headwear"):
+            continue
+        if model.get("id") == "headwear":
+            for box in model.get("boxes", []):
+                front = box["coordinates"][2] - (box.get("sizeAdd", 0) or 0)
+                if abs(front - HAT_PLANE) > 0.001:
+                    fail(f"{path.relative_to(ROOT)}: hat layer moved to {front}, must stay at {HAT_PLANE}")
+            continue
+
+        def walk(node, offset_z):
+            translate = node.get("translate") or [0, 0, 0]
+            z0 = offset_z + translate[2]
+            name = node.get("id") or ""
+            if "brow" in name.lower():
+                for box in node.get("boxes", []):
+                    front = box["coordinates"][2] + z0 - (box.get("sizeAdd", 0) or 0)
+                    if front <= HAT_PLANE:
+                        fail(
+                            f"{path.relative_to(ROOT)}: {name} at {front:.3f} sits in front of "
+                            f"the hat layer {HAT_PLANE} and will draw over skin glasses"
+                        )
+            for sub in node.get("submodels") or []:
+                if isinstance(sub, dict):
+                    walk(sub, z0)
+
+        walk(model, 0)
+
+
 def check():
     meta_path = ROOT / "pack.mcmeta"
     if not meta_path.is_file():
@@ -57,6 +98,8 @@ def check():
                     json.loads(f.read_text(encoding="utf-8"))
                 except ValueError as e:
                     fail(f"{f.relative_to(ROOT)} is not valid JSON: {e}")
+                if f.suffix == ".jem" and f.name.startswith("player"):
+                    check_head_layers(f)
                 count += 1
     print(f"Checked {count} JSON files, {len(overlays)} overlay(s)")
     return folders
diff --git a/docs/Fix-Glasses-Over-Eyebrows.md b/docs/Fix-Glasses-Over-Eyebrows.md
new file mode 100644
index 0000000..6dee30a
--- /dev/null
+++ b/docs/Fix-Glasses-Over-Eyebrows.md
@@ -0,0 +1,25 @@
+Some skins draw sunglasses on the **second skin layer** — the hat part. When the pack's 2nd-layer eyebrows sat in front of that layer, the eyebrows drew over the lens, and the eyebrows and the lens competed for the same depth as the camera moved. The result was edges that flickered on and off depending on the angle.
+
+## What was wrong
+
+The player model has three planes at the front of the head:
+
+| Surface | Before | After |
+| --- | --- | --- |
+| Head face | −4.000 | −4.000 |
+| 2nd-layer eyebrows | **−4.550** | **−4.350** |
+| Hat layer (your glasses) | −4.500 | −4.500 |
+
+At −4.550 the eyebrows were 0.05 in front of the hat layer. That is far enough to always win, which is why the eyebrows showed through the lens, and close enough that the two surfaces could swap as the camera turned.
+
+## What changed
+
+The eight 2nd-layer eyebrow boxes moved to −4.350, which is 0.15 behind the hat layer and 0.35 in front of the face. An opaque sunglass lens now hides them. A transparent one still lets them show through, so skins that use the 2nd layer for other things keep working.
+
+The hat layer itself is untouched. It stays at −4.500 with a size of 9, exactly as vanilla, because that layer is your glasses: moving it would hide or scale them.
+
+## Checking it
+
+`python3 build.py` fails with a clear message if any eyebrow box is at or in front of the hat plane, or if the hat layer leaves −4.500. That check runs over `assets/` and every overlay folder, so the copy that loads on 1.21.2 and newer is covered too.
+
+This is the same class of fault reported against Just Expressions as [issue #5](https://github.com/IthanMendoza/Just-Expressions/issues/5), where its face overlays sit one thousandth of a unit in front of the same plane.
