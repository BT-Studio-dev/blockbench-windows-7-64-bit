classTweaker v1    official
# Header must be line 1. Format: "classTweaker <version> <namespace>"; namespace
# is official because 26.x game jars ship unobfuscated.

# RenderPipelines#register survives 26.3 but is not public, and custom pipelines
# still register through it. Descriptor updated for the renderpearl move.
accessible  method  net/minecraft/client/renderer/RenderPipelines   register    (Lcom/mojang/renderpearl/api/pipeline/RenderPipeline;)Lcom/mojang/renderpearl/api/pipeline/RenderPipeline;

# REMOVED, with reasons, because a class tweaker entry that names something
# absent fails the whole build rather than being ignored:
#
#   Minecraft$GameLoadCookie -- reported "Could not find class" and MinecraftMixin
#     mixes into Minecraft (a game class, no widening needed) and only names the
#     type in a method descriptor string. The class is gone in 26.3; the mixin
#     itself will report the correct replacement target.
#   GpuTexture usage -- the field does not exist in the renderpearl move; this
#     was already removed once and the remaining reference is GpuTextureAccessor,
#     which needs its own fix rather than a widening.
#   GUI_TEXTURED_SNIPPET -- public in 26.3 after every pipeline constant gained
#     the _SNIPPET suffix. Widening it was never necessary.
