{
	"name": "Blockbench",
	"description": "Low-poly modeling and animation software",
	"desktopName": "net.blockbench.blockbench",
	"version": "5.2.2",
	"license": "GPL-3.0-or-later",
	"author": {
		"name": "JannisX11",
		"email": "info@blockbench.net"
	},
	"homepage": "https://blockbench.net",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JannisX11/blockbench.git"
	},
	"main": "electron/main.js",
	"type": "commonjs",
	"engines": {
		"node": ">=16.4.0"
	},
	"vue": {
		"runtimeCompiler": true
	},
	"build": {
		"afterSign": "scripts/notarize.mjs",
		"appId": "blockbench",
		"productName": "Blockbench",
		"artifactName": "${productName}_${version}.${ext}",
		"directories": {
			"output": "dist-electron"
		},
		"publish": [
			{
				"provider": "github"
			}
		],
		"mac": {
			"target": {
				"target": "default",
				"arch": [
					"arm64",
					"x64"
				]
			},
			"artifactName": "${productName}_${arch}_${version}.${ext}",
			"category": "macOS.application",
			"hardenedRuntime": true,
			"entitlements": "build/entitlements.mac.plist",
			"entitlementsInherit": "build/entitlements.mac.plist"
		},
		"files": [
			"!**/node_modules/electron-color-picker/library/darwin/**/*",
			"!**/node_modules/electron-color-picker/library/linux/**/*",
			"assets/",
			"build/",
			"content/",
			"css/",
			"font/",
			"icons/",
			"keymaps/",
			"lang/",
			"lib/gif.worker.js",
			"dist/bundle.electron.js",
			"dist/bundle.electron.js.map",
			"electron/",
			"index.html",
			"package.json",
			"favicon.png",
			"icon.icns",
			"icon.ico",
			"icon.png",
			"icon_maskable.png",
			"LICENSE.MD"
		],
		"dmg": {
			"artifactName": "${productName}_${arch}_${version}.${ext}",
			"window": {
				"x": 200,
				"y": 100,
				"width": 440,
				"height": 220
			},
			"contents": [
				{
					"x": 130,
					"y": 120
				},
				{
					"x": 360,
					"y": 120,
					"type": "link",
					"path": "/Applications"
				}
			]
		},
		"win": {
			"artifactName": "${productName}_win7_x64_${version}.${ext}",
			"target": {
				"target": "nsis",
				"arch": [
					"x64"
				]
			}
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"installerSidebar": "build/installerSidebar.bmp",
			"license": "LICENSE.MD",
			"include": "build/installer.nsh"
		},
		"linux": {
			"artifactName": "${productName}_${version}.${ext}",
			"target": [
				"deb",
				"rpm",
				"appImage"
			],
			"category": "Graphics;3DGraphics",
			"icon": "build/icon.png"
		},
		"fileAssociations": [
			{
				"ext": "bbmodel",
				"name": "Blockbench Project",
				"mimeType": "model/vnd.blockbench.bbmodel",
				"role": "Editor"
			},
			{
				"ext": "json",
				"name": "JSON Model",
				"mimeType": "application/json",
				"role": "Editor"
			}
		],
		"portable": {
			"artifactName": "${productName}_win7_x64_${version}_portable.${ext}"
		}
	},
	"scripts": {
		"dev": "node ./build.mjs --target=electron --watch --launch",
		"serve": "node ./scripts/set_web_bundle.mjs && node ./build.mjs --target=web --serve",
		"electron": "electron .",
		"build-web": "node ./scripts/set_web_bundle.mjs && node ./build.mjs --target=web",
		"build-electron": "node ./build.mjs --target=electron && node ./build-electron.mjs && node ./scripts/set_desktop_bundle.mjs",
		"build-test-portable": "npm run build-electron && electron-builder --win portable --publish=never",
		"publish-windows": "npm run build-electron && electron-builder -w --publish=onTagOrDraft && node ./scripts/rename_portable.mjs && electron-builder --win portable --publish=onTagOrDraft",
		"pwa": "node ./scripts/generate_pwa.mjs",
		"prepublish-web": "npm run build-web && npm run pwa && npm run generate-docs",
		"prepublish-beta": "node ./scripts/enable_beta.mjs && npm run build-web && npm run pwa && npm run generate-docs",
		"webapp": "git checkout gh-pages && git pull && git merge master --no-edit && git push && git checkout master",
		"check-unused-exports": "npx ts-unused-exports tsconfig.json",
		"generate-types": "tsc --project tsconfig.json && node ./scripts/convert_types.mjs",
		"publish-types": "npm publish ./types",
		"generate-docs": "npm run generate-types && npx typedoc --options typedoc.json",
		"preview": "node ./scripts/serve_web.mjs",
		"publish-linux": "npm run build-electron && electron-builder --linux --publish=never"
	},
	"overrides": {
		"three": "$three"
	},
	"devDependencies": {
		"@electron/notarize": "^2.5.0",
		"@lunapaint/tga-codec": "^0.2.0",
		"@types/jquery": "^3.5.32",
		"@types/node": "^22.14.0",
		"@types/spectrum": "^1.8.7",
		"@types/three": "^0.129.2",
		"@types/tinycolor2": "^1.4.6",
		"command-line-args": "^6.0.1",
		"dompurify": "^3.3.1",
		"dotenv": "^16.5.0",
		"electron": "^22.3.27",
		"electron-builder": "^23.6.0",
		"esbuild": "^0.21.5",
		"esbuild-vue": "^0.0.1",
		"file-saver": "^2.0.5",
		"gifenc": "^1.0.3",
		"jquery": "^3.7.1",
		"jszip": "^3.10.1",
		"marked": "^15.0.11",
		"molangjs": "^1.7.1",
		"peerjs": "^1.5.4",
		"prismjs": "^1.29.0",
		"strip-json-comments": "^5.0.3",
		"three": "^0.129.0",
		"tinycolor2": "^1.6.0",
		"ts-unused-exports": "^11.0.1",
		"typedoc": "^0.28.14",
		"typedoc-plugin-missing-exports": "^4.1.2",
		"typescript": "^5.8.3",
		"vue": "^2.7.16",
		"vue-sortable": "^0.1.3",
		"wintersky": "^1.3.2",
		"workbox-build": "^7.4.1"
	},
	"dependencies": {
		"@electron/remote": "^2.1.2",
		"electron-color-picker": "^0.2.0",
		"electron-updater": "^5.3.0"
	}
}
